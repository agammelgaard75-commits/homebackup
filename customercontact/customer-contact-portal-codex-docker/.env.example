# scripts/install.sh creates .env, sets the hostname, and generates both secrets.
# NEVER commit .env or include it in the deployment archive.
PORTAL_DOMAIN=portal.home.lab
COMPOSE_PROJECT_NAME=customer-contact-portal
PORT_BIND_IP=0.0.0.0
DJANGO_ALLOWED_HOSTS=portal.home.lab,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.home.lab
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=REPLACE_ON_INSTALL
POSTGRES_DB=customer_portal
POSTGRES_USER=customer_portal
POSTGRES_PASSWORD=REPLACE_ON_INSTALL
TZ=Europe/Copenhagen

# Private copy to .env; run scripts with DEPLOYMENT_MODE=development.
PORTAL_DOMAIN=portal.dev.localhost
COMPOSE_PROJECT_NAME=portal-development
PORT_BIND_IP=127.0.0.1
APP_IMAGE=portal-development-app:1.0.0
DJANGO_ALLOWED_HOSTS=portal.dev.localhost,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.dev.localhost
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=SET_OUTSIDE_GIT
POSTGRES_DB=customer_portal
POSTGRES_USER=customer_portal
POSTGRES_PASSWORD=SET_OUTSIDE_GIT
TZ=Etc/UTC
AUTH_MODE=local

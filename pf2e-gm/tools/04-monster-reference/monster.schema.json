{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PF2e GM Toolkit monster (version 1)",
  "type": "object",
  "required": ["name", "level", "max_hp"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "\\S"},
    "level": {"type": "integer", "minimum": -1, "maximum": 25},
    "max_hp": {"type": "integer", "minimum": 1},
    "ac": {"type": ["integer", "null"]},
    "fortitude": {"type": ["integer", "null"]},
    "reflex": {"type": ["integer", "null"]},
    "will": {"type": ["integer", "null"]},
    "perception": {"type": ["integer", "null"]},
    "traits": {"type": "array", "items": {"type": "string"}},
    "senses": {"type": "array", "items": {"type": "string"}},
    "skills": {"type": "object", "additionalProperties": {"type": "integer"}},
    "speeds": {"type": "array", "items": {"type": "object", "required": ["type", "feet"], "additionalProperties": false, "properties": {"type": {"type": "string", "minLength": 1}, "feet": {"type": "integer", "minimum": 1}}}},
    "attacks": {"type": "array", "items": {"$ref": "#/$defs/attack"}},
    "abilities": {"type": "array", "items": {"$ref": "#/$defs/ability"}},
    "spellcasting": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "source_book": {"type": "string"},
    "source_page": {"type": ["integer", "null"], "minimum": 1},
    "source_url": {"type": "string"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "actions": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "string", "minLength": 1}]},
    "attack": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {
      "name": {"type": "string", "minLength": 1},
      "type": {"type": ["string", "null"], "minLength": 1},
      "actions": {"oneOf": [{"$ref": "#/$defs/actions"}, {"type": "null"}]},
      "bonus": {"type": ["integer", "null"]},
      "traits": {"type": "array", "items": {"type": "string"}},
      "damage": {"type": "string"},
      "effect": {"type": "string"}
    }},
    "ability": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {
      "name": {"type": "string", "minLength": 1},
      "actions": {"oneOf": [{"$ref": "#/$defs/actions"}, {"type": "null"}]},
      "traits": {"type": "array", "items": {"type": "string"}},
      "trigger": {"type": ["string", "null"]},
      "requirements": {"type": ["string", "null"]},
      "description": {"type": "string"},
      "dc": {"type": ["integer", "null"]}
    }},
    "entry": {"type": "object", "required": ["name"], "additionalProperties": false, "properties": {
      "name": {"type": "string", "minLength": 1}, "description": {"type": "string"},
      "modifier": {"type": ["integer", "null"]}, "damage": {"type": "string"},
      "usable_in_combat": {"type": "boolean"}, "offensive": {"type": "boolean"}
    }}
  }
}

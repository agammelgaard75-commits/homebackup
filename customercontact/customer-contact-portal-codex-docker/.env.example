# Copy to .env, chmod 600, and edit privately. Never commit the configured file.
# scripts default to production; development requires DEPLOYMENT_MODE=development.
PORTAL_DOMAIN=portal.example.internal
COMPOSE_PROJECT_NAME=customer-contact-portal
PORT_BIND_IP=0.0.0.0
APP_IMAGE=customer-contact-portal-app:1.0.0
DJANGO_ALLOWED_HOSTS=portal.example.internal,127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.internal
DJANGO_DEBUG=0
# Generate each independently with: od -An -tx1 -N 48 /dev/urandom | tr -d ' \n'
# Redirect generator output to private configuration; never to shared logs.
DJANGO_SECRET_KEY=SET_OUTSIDE_GIT
POSTGRES_DB=customer_portal
POSTGRES_USER=customer_portal
POSTGRES_PASSWORD=SET_OUTSIDE_GIT
TZ=Etc/UTC
AUTH_MODE=oidc
OIDC_ISSUER_URL=https://keycloak.example.internal/realms/customer-portal
OIDC_CLIENT_ID=customer-portal
OIDC_CLIENT_SECRET=SET_OUTSIDE_GIT
OIDC_API_AUDIENCE=customer-portal
OIDC_REDIRECT_URI=https://portal.example.internal/oidc/callback/
# Set to 1 only after staging login, role, logout and bearer-token verification.
OIDC_VERIFIED=0
# Host-side settings; keep backups private and copy to encrypted off-server storage.
# BACKUP_DIR=/srv/portal-backups
BACKUP_RETENTION_DAYS=30
# Tune after measuring load; initial recommended host: 2 CPU, 4 GiB RAM.
APP_MEMORY_LIMIT=1g
APP_CPU_LIMIT=2.0
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.0
PROXY_MEMORY_LIMIT=256m
PROXY_CPU_LIMIT=0.5
JSON_IMPORT_MAX_BYTES=1048576
JSON_IMPORT_MAX_RECORDS=500

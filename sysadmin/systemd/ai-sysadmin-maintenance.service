[Unit]
Description=AI Sysadmin weekly approved maintenance
Documentation=file:/opt/ai-sysadmin/README.md
ConditionPathExists=/opt/ai-sysadmin/bin/ai-sysadmin
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/ai-sysadmin/bin/ai-sysadmin maintain
User=root
Group=root
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectHome=true
NoNewPrivileges=true
TimeoutStartSec=2h

